// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GENDER {
  NONE
  MALE
  FEMALE
}

model Room {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  gender GENDER
  students Student[]
  isBlocked Boolean @default(false)
}

model Student {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  roomName String
  room     Room   @relation(fields: [roomName], references: [name])
  arrivalId Int?
  arrival  Arrival? @relation(fields: [arrivalId], references: [id])
}

model Arrival {
  id Int @id @default(autoincrement())
  students Student[]
  createdAt DateTime @default(now())
  arrivalTime DateTime
}

// For future extensions based on your other API routes
model Whitelist {
  id    Int    @id @default(autoincrement())
  email String @unique
}

model Settings {
  id    Int    @id @default(autoincrement())
  reservationsEnabled Boolean @default(false)
}

model Faq {
  id Int @id @default(autoincrement())
  question String
  answer String
} 

